# Copy to .env if you like (the app reads real environment variables; use `export` or your host's settings).
PORT=3000
# Where the database file, photos and the admin claim-code file live. Use a persistent disk in real use.
DATA_DIR=./data_local
# Public address (used inside ID-card QR codes). Empty = use whatever address the visitor used.
PUBLIC_URL=
NODE_ENV=development
# Optional: change who the two administrators are (default: John and Abisade)
# ADMIN_EMAILS=interschoolmusic@gmail.com,abisade@nismcaa.com
