    <a class="tour-card" href="/about"><span class="tour-pic"><img src="/static/img/panel-trophies.jpg" alt="Award plaques and trophies on a table" loading="lazy"><span class="tour-ico"><%- include('partials/icon', { n: 'heart', size: 28 }) %></span></span><span class="tour-body"><strong>What NISMCAA does</strong><span>Music competition and academic awards for schools.</span><em>Open &rarr;</em></span></a>
    <a class="tour-card" href="/course"><span class="tour-pic"><img src="/static/img/volunteers-teaching.jpg" alt="A NISMCAA volunteer teaching music to a class" loading="lazy"><span class="tour-ico"><%- include('partials/icon', { n: 'learn', size: 28 }) %></span></span><span class="tour-body"><strong>The volunteer course</strong><span>Read the lessons, free and open to everyone.</span><em>Open &rarr;</em></span></a>
    <a class="tour-card" href="/benefits"><span class="tour-pic"><img src="/static/img/banner-id.jpg" alt="Smiling volunteer holding her NISMCAA ID card" loading="lazy"><span class="tour-ico"><%- include('partials/icon', { n: 'id', size: 28 }) %></span></span><span class="tour-body"><strong>Volunteer benefits</strong><span>Certificates, training, references and more.</span><em>Open &rarr;</em></span></a>
    <a class="tour-card" href="/about#meet"><span class="tour-pic"><img src="/static/img/meeting-virtual.jpg" alt="Team in a virtual video meeting" loading="lazy"><span class="tour-ico"><%- include('partials/icon', { n: 'video', size: 28 }) %></span></span><span class="tour-body"><strong>Meet in person or online</strong><span>See how our teams come together.</span><em>Open &rarr;</em></span></a>
    <a class="tour-card" href="/guests"><span class="tour-pic"><img src="/static/img/meeting-in-person.jpg" alt="Business meeting in a conference room" loading="lazy"><span class="tour-ico"><%- include('partials/icon', { n: 'users', size: 28 }) %></span></span><span class="tour-body"><strong>For sponsors and vendors</strong><span>Our guest area for partners and suppliers.</span><em>Open &rarr;</em></span></a>
    <a class="tour-card" href="/contact"><span class="tour-pic"><img src="/static/img/meeting-room-top.jpg" alt="NISMCAA team meeting in front of a world map" loading="lazy"><span class="tour-ico"><%- include('partials/icon', { n: 'send', size: 28 }) %></span></span><span class="tour-body"><strong>Contact us</strong><span>We would love to hear from you.</span><em>Open &rarr;</em></span></a>
  </div>
</section>

<%- include('partials/split', { img: 'panel-trophies.jpg', alt: 'Gold award plaques and trophies on a table', icon: 'heart', kicker: 'What NISMCAA does', title: 'Music and learning, together', body: 'A music competition for students and academic awards that recognize educational achievement, for schools in many countries.', href: '/about', label: 'Learn more' }) %>
