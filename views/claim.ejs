<%- include('partials/head') %>
<h1>Administrator set-up</h1>
<p>This page is for the NISMCAA administrators only, and it works once per person. Enter your own e-mail and the one-time claim code from the server owner, then choose your own password. The page switches itself off when both administrators are set up.</p>
<% if (error) { %><div class="flash err" role="alert"><%= error %></div><% } %>
<form class="card stack" method="post" action="/admin/claim" autocomplete="off">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <label for="email">Your administrator e-mail</label><input id="email" name="email" type="email" required>
  <label for="code">Claim code</label><input id="code" name="code" type="text" required placeholder="XXXXX-XXXXX">
  <label for="password">New password <span class="hint">(10 or more characters)</span></label><input id="password" name="password" type="password" required minlength="10" autocomplete="new-password">
  <label for="password2">Confirm new password</label><input id="password2" name="password2" type="password" required minlength="10" autocomplete="new-password">
  <p><button class="btn gold" type="submit">Set my password</button></p>
</form>
<%- include('partials/foot') %>
