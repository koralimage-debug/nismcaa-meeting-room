<%- include('../partials/head') %>
<h1>People</h1>
<%- include('../partials/adminnav') %>
<form class="card" method="get" action="/admin/people" style="display:flex;gap:10px;flex-wrap:wrap">
  <select name="status" style="max-width:240px"><option value="">All statuses</option>
  <% ['applicant','interest','waiting','approved','declined','ended'].forEach(function(s){ %><option <%= s === status ? 'selected' : '' %>><%= s %></option><% }) %></select>
  <input type="text" name="q" value="<%= q %>" placeholder="Name, e-mail or ID" style="max-width:300px">
  <button class="btn" type="submit">Filter</button>
</form>
<div class="table-wrap"><table>
<tr><th>Name</th><th>E-mail</th><th>Status</th><th>Country</th><th>Department</th><th>ID</th><th>Valid until</th></tr>
<% rows.forEach(function(r){ %><tr>
  <td><a href="/admin/people/<%= r.id %>"><%= r.name %></a></td><td><%= r.email %></td><td><%= access.statusLabel(r) %></td>
  <td><%= r.country || (r.country_chosen + ' (chosen)') %></td><td><%= r.department || '' %></td><td><%= r.volunteer_id || '' %></td><td><%= fmtDate(r.id_expires_at) %></td></tr>
<% }) %>
</table></div>
<% if (!rows.length) { %><p>No people match.</p><% } %>
<%- include('../partials/foot') %>
