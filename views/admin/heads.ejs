<%- include('../partials/head') %>
<h1>Head seats</h1>
<%- include('../partials/adminnav') %>
<p class="muted">Every department in every country starts with an empty Head seat. Until a head is assigned, the administrators act as head. A head must be an approved volunteer of that country who passed the course.</p>
<% COUNTRIES.forEach(function(c){ %>
<h2 id="<%= encodeURIComponent(c) %>"><%= c %></h2>
<div class="table-wrap"><table><tr><th>Department</th><th>Head</th><th>Assign or change</th></tr>
<% DEPARTMENTS.forEach(function(d){ var s = seats.find(function(x){ return x.country === c && x.department === d; }); %>
<tr><td><%= d %></td><td><%= s && s.head_name ? s.head_name : 'Empty seat (admins act as head)' %></td>
<td><form class="inline-form" method="post" action="/admin/heads" style="display:flex;gap:6px;flex-wrap:wrap">
  <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="country" value="<%= c %>"><input type="hidden" name="department" value="<%= d %>">
  <select name="user_id" style="max-width:240px"><option value="">Empty the seat</option>
  <% cand.filter(function(u){ return u.country === c; }).forEach(function(u){ %><option value="<%= u.id %>" <%= s && s.user_id === u.id ? 'selected' : '' %>><%= u.name %></option><% }) %></select>
  <button class="btn small" type="submit">Save</button></form></td></tr>
<% }) %></table></div>
<% }) %>
<%- include('../partials/foot') %>
