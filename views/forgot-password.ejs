<%- include('partials/head') %>
<div class="auth">
  <aside class="auth-panel" aria-hidden="true">
    <img src="/static/img/logo-sm.png" alt="" width="72" height="72">
    <p class="auth-quote">A short-lived link, sent only to you.</p>
    <p class="auth-sub">Reset your password in a few careful steps.</p>
  </aside>
  <div class="auth-main">
<%- include('partials/authband', { mobileOnly: true, img: 'meeting-room-top.jpg', alt: 'NISMCAA team in front of a world map', line: 'Reset your password' }) %>
<% if (sent) { %>
<h1>Check your e-mail</h1>
<div class="card gold stack reset-panel" role="status">
  <p class="reset-mark" aria-hidden="true">&#10003;</p>
  <p class="lead"><%= message %></p>
  <p class="muted">You can close this page. If the message is not there in a few minutes, look in your spam folder, or request a new link.</p>
  <p class="reset-actions"><a class="btn gold" href="/sign-in">Back to sign in</a></p>
</div>
<% } else { %>
<h1>Forgot your password?</h1>
<% if (error) { %><div class="flash err" role="alert"><%= error %></div><% } %>
<p class="lead">Enter the e-mail you use to sign in. If we have an account for it, we will send you a reset link that expires in 60 minutes.</p>
<form class="card stack" method="post" action="/forgot-password">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <label for="email">E-mail (your sign-in ID)</label>
  <input id="email" name="email" type="email" required autocomplete="username" value="<%= email %>">
  <p class="reset-actions"><button class="btn gold" type="submit">Send reset link</button></p>
</form>
<p>Remembered it? <a href="/sign-in">Sign in</a>.</p>
<% } %>
<%- include('partials/authfoot', { mobileOnly: true, img: 'volunteers-seating.jpg', alt: 'Volunteers welcoming students at an event', text: 'Your team is waiting for you.' }) %>
  </div>
</div>
<%- include('partials/foot', { footBand: true }) %>
