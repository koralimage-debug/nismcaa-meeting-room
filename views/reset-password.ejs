<%- include('partials/head') %>
<div class="auth">
  <aside class="auth-panel" aria-hidden="true">
    <img src="/static/img/logo-sm.png" alt="" width="72" height="72">
    <% if (done) { %>
    <p class="auth-quote">Your new password has been saved.</p>
    <p class="auth-sub">You can sign in when you are ready.</p>
    <% } else { %>
    <p class="auth-quote">Choose a password only you will know.</p>
    <p class="auth-sub">Use at least 10 characters. This link works once.</p>
    <% } %>
  </aside>
  <div class="auth-main">
<%- include('partials/authband', { mobileOnly: true, img: 'meeting-in-person.jpg', alt: 'Business meeting with NISMCAA logos on the walls', line: done ? 'Your password is ready' : 'Set a new password' }) %>
<% if (done) { %>
<h1>Your password is ready</h1>
<div class="card gold stack reset-panel" role="status">
  <p class="reset-mark" aria-hidden="true">&#10003;</p>
  <p class="lead">Your new password has been saved. Sign in when you are ready. For your safety, other signed-in sessions have been ended.</p>
  <p class="reset-actions"><a class="btn gold" href="/sign-in">Sign in</a></p>
</div>
<% } else if (!valid) { %>
<h1>This link has expired</h1>
<div class="card gold stack reset-panel">
  <p class="lead"><%= message %></p>
  <p class="reset-actions"><a class="btn gold" href="/forgot-password">Request a new link</a></p>
  <p><a href="/sign-in">Back to sign in</a></p>
</div>
<% } else { %>
<h1>Set a new password</h1>
<% if (error) { %><div class="flash err" role="alert"><%= error %></div><% } %>
<p class="lead">Choose a new password for your Meeting Room account. It must be at least 10 characters, and you will type it twice to confirm.</p>
<form class="card stack" method="post" action="/reset-password">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <input type="hidden" name="token" value="<%= token %>">
  <label for="password">New password <span class="hint">(10 or more characters)</span></label>
  <input id="password" name="password" type="password" required minlength="10" autocomplete="new-password" data-toggle-pw>
  <label for="password2">Confirm new password</label>
  <input id="password2" name="password2" type="password" required minlength="10" autocomplete="new-password">
  <p class="reset-actions"><button class="btn gold" type="submit">Save new password</button></p>
</form>
<% } %>
<%- include('partials/authfoot', { mobileOnly: true, img: 'volunteers-teaching.jpg', alt: 'Volunteers teaching students', text: 'Welcome back to the Meeting Room.' }) %>
  </div>
</div>
<%- include('partials/foot', { footBand: true }) %>
