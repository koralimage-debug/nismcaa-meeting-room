  <a href="/admin/meetings" class="<%= path.startsWith('/admin/meetings') ? 'on' : '' %>">Meetings</a>
  <a href="/admin/people" class="<%= path.startsWith('/admin/people') ? 'on' : '' %>">People</a>
  <a href="/admin/heads" class="<%= path === '/admin/heads' ? 'on' : '' %>">Head seats</a>
  <a href="/admin/key" class="<%= path === '/admin/key' ? 'on' : '' %>">Answer key</a>
  <a href="/admin/settings" class="<%= path === '/admin/settings' ? 'on' : '' %>">Settings</a>
  <a href="/admin/log" class="<%= path === '/admin/log' ? 'on' : '' %>">Change log</a>
  <a href="/meeting-room/plan/global">Global roll-up</a>
