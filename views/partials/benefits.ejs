<%
var BENEFITS = [
 ['id','Certificate of volunteering','An official NISMCAA certificate recognizing your service.'],
 ['heart','Motivation opportunities','Cash motivation opportunities for active and outstanding volunteers.'],
 ['globe','Data gifts','Data gift opportunities to keep you connected while you serve.'],
 ['send','Travel opportunities','As NISMCAA expands, selected outstanding volunteers may join our international programs.'],
 ['learn','Scholarship opportunities','Scholarship opportunities for selected volunteers and their children, where available.'],
 ['test','Knowledge and training','Training in child protection, event management and leadership.'],
 ['notes','Reference letters','Recommendation and reference letters for committed volunteers.'],
 ['id','Official ID and kit','Your NISMCAA digital ID, plus a branded T-shirt or kit where available.'],
 ['users','Networking','Meet musicians, celebrities, dignitaries and sponsors.'],
 ['video','Events and awards night','Access to NISMCAA events and the awards night.'],
 ['inbox','Event-day support','Meals and transport support on event days.'],
 ['arrow','Leadership path','Strong contributors can grow into department lead roles.'],
 ['heart','Recognition','Volunteer of the Year awards and shout-outs on our social media.'],
 ['approval','Priority for paid roles','Priority consideration when paid NISMCAA roles open up.'],
 ['learn','Music academy access','Opportunities to join academy sessions and masterclasses.'],
 ['plan','CV and portfolio','Real experience for your CV. Media volunteers can earn credits for their work.'],
 ['join','Community service','Meaningful service that strengthens your CV, including for recent graduates.'],
 ['admin','Children\'s safety first','Every volunteer is trained in child care and protection.']
]; %>
<h2 class="section-title">Everything waiting for you</h2>
<p class="muted">Give your time to children's music education, and grow with us. Here's what's waiting for you.</p>
<div class="benefit-grid">
<% BENEFITS.forEach(function(b, i){ if (i === 6 || i === 12) { %></div>
<%- include('photoband', i === 6 ? { img: 'panel-trophies.jpg', alt: 'Gold award plaques and trophies', cap: 'Recognition and awards for committed volunteers' } : { img: 'volunteers-teaching.jpg', alt: 'A volunteer teaching music to a class', cap: 'Real experience that grows your CV', pos: 'center 35%' }) %>
<div class="benefit-grid"><% } %>
  <div class="benefit<%= i === BENEFITS.length - 1 ? ' benefit-safe' : '' %>"><span class="tile-ico<%= i % 2 ? ' gold' : '' %>"><%- include('icon', { n: b[0], size: 24 }) %></span><div><h3><%= b[1] %></h3><p><%= b[2] %></p></div></div>
<% }) %>
</div>
<p class="muted small">Some benefits depend on role, performance, attendance and available sponsorship.</p>
