<%- include('partials/head') %>
<h1>Change your password</h1>
<% if (user.must_change_pw) { %><p class="note">You are using a temporary password. Please choose your own password now.</p><% } %>
<% if (error) { %><div class="flash err" role="alert"><%= error %></div><% } %>
<form class="card stack" method="post" action="/account/password">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <label for="current">Current (or temporary) password</label><input id="current" name="current" type="password" required autocomplete="current-password">
  <label for="password">New password <span class="hint">(10 or more characters)</span></label><input id="password" name="password" type="password" required minlength="10" autocomplete="new-password">
  <label for="password2">Confirm new password</label><input id="password2" name="password2" type="password" required minlength="10" autocomplete="new-password">
  <p><button class="btn gold" type="submit">Save new password</button></p>
</form>
<%- include('partials/foot') %>
