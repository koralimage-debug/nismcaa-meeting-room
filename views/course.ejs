<%- include('partials/head') %>
<h1>NISMCAA Volunteer Course</h1>
<figure class="banner"><img src="/static/img/banner-course.jpg" alt="Volunteers from different backgrounds studying the course together" loading="lazy"><figcaption>Learn together, serve together</figcaption></figure>
<div class="card gold course-intro">
  <p>Read all twelve orientation lessons and the seven Child Care &amp; Protection lessons. The course is open to everyone. Then take the final test.</p>
  <p>
    <% if (user && user.status === 'applicant') { %><a class="btn gold" href="/course/test">Take the final test</a>
    <% } else if (!user) { %><a class="btn gold" href="/sign-up">Sign up to take the final test</a> <a class="btn ghost" href="/sign-in">Sign in</a>
    <% } else if (user.status === 'waiting') { %><span class="note">You passed. An NISMCAA administrator will review your application.</span>
    <% } else { %><a class="btn ghost" href="/course/test">Final test</a><% } %>
  </p>
  <details><summary><strong>All lessons</strong></summary>
    <div class="two"><div><h3>Orientation (12)</h3><ol style="padding-left:20px"><% course.orientLessons.forEach(function(l,i){ %><li><a href="#o<%= i+1 %>"><%= l.replace(/^Lesson \d+:\s*/,'') %></a></li><% }) %></ol></div>
    <div><h3>Child Care &amp; Protection (7)</h3><ol style="padding-left:20px"><% course.ccpLessons.forEach(function(l,i){ %><li><a href="#c<%= i+1 %>"><%= l.replace(/^Lesson \d+:\s*/,'') %></a></li><% }) %></ol></div></div>
  </details>
</div>
<div class="lessonbar" id="lessonbar" hidden aria-live="off"><div class="lessonbar-in"><span class="lessonbar-label" id="lessonbar-label"></span><span class="lessonbar-pct" id="lessonbar-pct"></span></div><div class="bar" role="progressbar" aria-label="Course reading progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span id="lessonbar-fill"></span></div></div>
<div id="course-text" class="course-text">
<%
var BANDS = {
  o4: ['volunteers-teaching.jpg', 'A volunteer teaching music to a class', 'Music in every classroom', 'center 35%'],
  o7: ['meeting-virtual.jpg', 'Team in a virtual video meeting', 'Teams that meet online and in person'],
  o10: ['meeting-in-person.jpg', 'Team meeting in a conference room', 'Organizing events together'],
  c3: ['volunteers-seating.jpg', 'Volunteers welcoming students at an event', 'Children come first, every time'],
  c6: ['banner-id.jpg', 'Smiling volunteer with her NISMCAA ID card', 'Trained, trusted and ready to serve']
};
function band(key) { var b = BANDS[key]; if (b) { %><%- include('partials/photoband', { img: b[0], alt: b[1], cap: b[2], pos: b[3] }) %><% } }
function renderEls(els, prefix) { var n = 0;
  els.forEach(function(e){
    if (e.type === 'lesson') { n++; band(prefix + n); %><h3 class="lesson" id="<%= prefix %><%= n %>"><%= e.text %></h3><% }
    else if (e.type === 'h') { %><h4><%= e.text %></h4><% }
    else if (e.type === 'p') { %><p><%= e.text %></p><% }
    else if (e.type === 'ul') { %><ul><% e.items.forEach(function(i){ %><li><%= i %></li><% }) %></ul><% }
    else if (e.type === 'table') { %><div class="table-wrap"><table><thead><tr><% e.header.forEach(function(h){ %><th><%= h %></th><% }) %></tr></thead><tbody><% e.rows.forEach(function(r){ %><tr><% r.forEach(function(c){ %><td><%= c %></td><% }) %></tr><% }) %></tbody></table></div><% }
  });
}
%>
<section aria-label="Volunteer information"><% renderEls(course.part1, 'p') %></section>
<%- include('partials/photoband', { img: 'panel-trophies.jpg', alt: 'Gold award plaques and trophies', cap: 'Music and learning, together' }) %>
<section aria-label="Orientation lessons"><% renderEls(course.orient, 'o') %></section>
<%- include('partials/photoband', { img: 'volunteers-teaching.jpg', alt: 'A volunteer teaching music to a class', cap: 'Keeping every child safe and cared for', pos: 'center 30%' }) %>
<section aria-label="Child Care and Protection lessons"><% renderEls(course.ccp, 'c') %></section>
</div>
<div class="card gold">
  <h3>Ready for the final test?</h3>
  <p>50 multiple-choice questions. To pass you need <strong>at least 40 of 50 (80%)</strong> and <strong>at least 9 of the 10 child-protection questions</strong> (questions 41 to 50). You can retake the test as often as you need.</p>
  <% if (user && user.status === 'applicant') { %><a class="btn gold" href="/course/test">Take the final test</a><% } else if (!user) { %><a class="btn gold" href="/sign-up">Sign up first</a><% } %>
</div>
<%- include('partials/foot', { footBand: true }) %>
